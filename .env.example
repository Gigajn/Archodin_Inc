# Defaults to localhost so the office is never exposed by accident.
AAHC_BIND_ADDR=127.0.0.1:8000
RUST_LOG=info

# --- Free-tier LLM lanes (used from ticket 04 onwards) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Skill hunting ---
GITHUB_TOKEN=

# --- Trading ---
# Not used until ticket 11. When they arrive they MUST be withdrawal-disabled
